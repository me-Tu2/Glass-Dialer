<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:angle="135"
                android:startColor="#80FFFFFF"
                android:centerColor="#1FFFFFFF"
                android:endColor="#40FFFFFF" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="31dp" />
            <gradient
                android:angle="270"
                android:startColor="#CC14161D"
                android:endColor="#EB06070A" />
        </shape>
    </item>
</layer-list>
